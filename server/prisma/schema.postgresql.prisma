// Production schema — PostgreSQL (Neon / Supabase). Dev uses schema.prisma (SQLite).
// Apply: npm run db:push:prod  (with DATABASE_URL + DIRECT_URL in .env)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======================== MODELS ========================

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  phone             String         @unique
  passwordHash      String
  googleId          String?        @unique
  role              String         @default("CITIZEN") // CITIZEN | LAWYER
  name              String
  language          String         @default("en")
  isPremium         Boolean        @default(false)
  trialsUsed        Int            @default(0) // max 3 lifetime for free
  isFirstLogin      Boolean        @default(true) // for walkthrough
  isBanned          Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Structured Legal Name
  firstName         String?
  middleName        String?
  lastName          String?
  suffix            String?
  aliases           String? // A.K.A. / Maiden Name

  // Lawyer-specific fields
  barNumber         String?
  barAdmissionYear  Int?
  ibpChapter        String?
  ibpIdNumber       String?
  mcleComplianceNo  String?
  lawFirmName       String?
  specializations   String? // JSON array string: ["Criminal","Family"]
  consultationFee   Float? // legacy; synced from consultationFeeMin
  consultationFeeMin Float?
  consultationFeeMax Float?
  acceptingBookings Boolean        @default(true)
  bio               String?
  yearsOfExperience Int?
  practiceType      String? // "PUBLIC" | "PRIVATE"
  isVerified        Boolean        @default(false)
  avatarUrl         String?
  paymentMethods    String? // JSON: [{type, qrUrl, accountName}]
  credentials       String?
  rating            Float          @default(0)
  ratingCount       Int            @default(0)
  noShowStrikes     Int            @default(0)

  // Lawyer wallet (platform-owned payment model)
  walletBalance     Float          @default(0) // withdrawable after COMPLETED
  walletPending     Float          @default(0) // held until consultation COMPLETED

  // Citizen personal-profile & legal capacity fields
  dob               String?
  gender            String?
  citizenship       String?        @default("Filipino")
  civilStatus       String?
  occupation        String?
  indigencyTier     String?        @default("STANDARD") // INDIGENT_PAO | LOW_INCOME | STANDARD | HIGH_NET_WORTH

  // Structured Philippine Address (PSGC)
  region            String?
  province          String?
  city              String?
  barangay          String?
  streetAddress     String?
  zipCode           String?
  address           String? // Full formatted address string

  // Citizen Identification & Emergency Contact
  citizenIdType         String? // PHILID | PASSPORT | DRIVERS_LICENSE | UMID | POSTAL | PRC | VOTER | STUDENT_ID | OTHER_GOV
  citizenIdNumber       String?
  citizenIdUrl          String?
  citizenIdBackUrl      String?
  citizenSelfieUrl      String?
  citizenVerificationStatus String @default("NOT_STARTED") // NOT_STARTED | PENDING | VERIFIED | REJECTED
  emailVerified         Boolean        @default(false)
  suspensionUntil       DateTime?
  suspensionReason      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelationship String?

  // Legal Compliance & Audit Trail (RA 10173)
  registrationIp    String?
  privacyConsentAt  DateTime?      @default(now())
  privacyConsentVer String?        @default("1.0")

  // Security question & hashed answer for 2-factor password reset
  securityQuestion    String?
  securityAnswerHash  String?

  // Lawyer KYC / identity-verification status machine.
  lawyerVerificationStatus        String   @default("NOT_STARTED")
  lawyerVerificationScore         Float?   // 0-100 aggregate confidence
  lawyerVerificationRejectionReason String?
  lawyerVerificationCooldownUntil DateTime? // re-registration blocked until this date
  lawyerVerificationUpdatedAt     DateTime?

  // Relations
  consultations       Consultation[]
  availabilities      Availability[]
  bookingsAsCitizen   Booking[]      @relation("CitizenBookings")
  bookingsAsLawyer    Booking[]      @relation("LawyerBookings")
  reviews             Review[]
  subscription        Subscription?
  notifications       Notification[]
  reportsFiled        Report[]       @relation("Reporter")
  reportsReceived     Report[]       @relation("Reported")
  lawyerVerification  LawyerVerification?
  payments            Payment[]
  payoutRequests      PayoutRequest[]
}

model LawyerVerification {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Professional registry match
  submittedFullName      String?  // name lawyer entered
  submittedRollNumber    String?  // SC roll / IBP number
  rollMatchedName        String?  // canonical name from seed registry
  rollMatchHit           Boolean  @default(false)

  // Government ID artifact
  govIdType              String?  // DRIVERS_LICENSE | UMID | PASSPORT | PRC_ID | PHILHEALTH | SSS | VOTERS | POSTAL | OTHER
  govIdUrl               String?  // local path or bucket URL
  govIdOcrName           String?  // text parsed from ID card
  govIdOcrProvider       String?  // engine that read the ID: groq-vision | gemini-vision | noop
  govIdUploadedAt        DateTime?

  // Liveness challenge
  challengeCode          String?  // e.g. "OX-8392" issued by server
  challengeIssuedAt      DateTime?
  selfieUrl              String?  // selfie photo file path
  selfieUploadedAt       DateTime?
  faceMatchScore         Float?   // 0-100 face comparison score
  faceMatchProvider      String?  // engine that compared faces: groq-vision | gemini-vision | noop
  ocrNameMatchScore      Float?   // 0-100 name match score (ID name vs account/roll name)

  // Payment identity link (anti-fraud)
  paymentAccountName     String?  // GCash / bank holder name extracted from paymentMethods
  paymentNameMatchScore  Float?   // 0-100 match score (payment name vs account name)

  // Computed verdict
  challengeCodeMatched   Boolean  @default(false)
  aggregateConfidence    Float    @default(0) // 0-100 aggregate score
  decision               String   @default("PENDING") // PENDING | AUTO_APPROVE | NEEDS_REUPLOAD | REJECTED
  decisionReason         String?  // detailed breakdown for user feedback
  decisionAt             DateTime?
  attempts               Int      @default(0) // attempt count (max 3)
  lastSubmittedAt        DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model RollOfAttorneys {
  rollNumber         String    @id
  fullName           String
  admittedAt         DateTime?
  status             String    @default("ACTIVE") // ACTIVE | SUSPENDED | DISBARRED
  region             String?
  address            String?
  lastLiveCheckedAt  DateTime?
  createdAt          DateTime  @default(now())

  @@index([fullName])
}

model Consultation {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  title           String?
  category        String   // Family, Criminal, Labor, Property, Consumer, etc.
  description     String
  fileUrl         String?  // Uploaded case document PDF/DOCX
  extractedText   String?  // Extracted document text
  aiResult        String   // JSON string of AI analysis result
  analysisMeta    String?  // JSON string: { model, provider, tokens, durationMs, corpusVersion }
  followUpHistory String?  // JSON string array of { id, role, content, createdAt }
  followUpCount   Int      @default(0)
  isFree          Boolean  @default(true)
  trialsCharged   Boolean  @default(true)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([userId, deletedAt])
}

model LawReference {
  id           String  @id @default(uuid())
  category     String
  name         String
  fullText     String
  link         String?
  keywords     String
  priority     String  @default("medium")
  guidanceJson String?
}

model Availability {
  id        String   @id @default(uuid())
  lawyerId  String
  lawyer    User     @relation(fields: [lawyerId], references: [id])
  date      DateTime
  startTime String   // e.g. "09:00"
  endTime   String   // e.g. "10:00"
  isBooked  Boolean  @default(false)
  version   Int      @default(0) // Optimistic concurrency control
  createdAt DateTime @default(now())

  bookings  Booking[]
}

model Booking {
  id                String       @id @default(uuid())
  citizenId         String
  citizen           User         @relation("CitizenBookings", fields: [citizenId], references: [id])
  lawyerId          String
  lawyer            User         @relation("LawyerBookings", fields: [lawyerId], references: [id])
  availabilityId    String
  availability      Availability @relation(fields: [availabilityId], references: [id])
  preferredStartTime String?
  sessionStartTime  String?
  sessionEndTime    String?
  status            String       @default("REQUESTED")
  feeAtBooking      Float
  consultationId    String?      // Optional linked AI consultation summary
  caseDescription   String?      // Optional case summary provided by citizen
  paymentReference  String?      // Reference number from payment submission
  paymentReceiptUrl String?      // Uploaded receipt photo/PDF
  paymentSnapshot   String?      // JSON snapshot of selected payment method
  paymentVerifiedAt DateTime?    // When lawyer verified the payment
  quotedFee         Float?       // Set by lawyer on approve
  platformFee       Float?       // 10% commission, set on approve / payment
  lawyerShare       Float?       // 85% to lawyer, set on payment confirm
  paymentId         String?      @unique // Links to Payment model
  approvedAt        DateTime?    // For 24h unpaid expiry cron
  roomId            String?      // Opaque PeerJS room token (UUID)
  transcript        String?      // Call transcript
  recordingUrl      String?      // Uploaded consultation recording (internal path)
  consultConsentAt  DateTime?    // Server-audited preflight consent timestamp
  reminder15MinSent Boolean      @default(false)
  chatMessages      String?      // JSON array of messages
  chatClosedAt      DateTime?
  noShowParty       String?      // "CITIZEN" | "LAWYER"
  citizenDeletedAt  DateTime?
  lawyerDeletedAt   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  review            Review?
  recordHash        RecordHash?
  payment           Payment?     @relation(fields: [paymentId], references: [id])

  @@index([citizenId, citizenDeletedAt])
  @@index([lawyerId, lawyerDeletedAt])
  @@index([lawyerId, status])
  @@index([availabilityId])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  citizenId String
  citizen   User     @relation(fields: [citizenId], references: [id])
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  price     Float    @default(299)
  status    String   @default("ACTIVE") // ACTIVE | EXPIRED
  reference String?  // Payment reference number
  startDate DateTime @default(now())
  endDate   DateTime // startDate + 30 days
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // AI_READY, BOOKING_REQUEST, BOOKING_APPROVED, etc.
  isRead    Boolean  @default(false)
  linkTo    String?  // URL to navigate to
  createdAt DateTime @default(now())
}

model RecordHash {
  id               String    @id @default(uuid())
  bookingId        String    @unique
  booking          Booking   @relation(fields: [bookingId], references: [id])
  dataHash         String    // SHA-256
  previousHash     String?   // Chain linkage
  blockchainTxHash String?   // Ethereum tx hash
  anchoredAt       DateTime?
  createdAt        DateTime  @default(now())
}

model OtpChallenge {
  id        String   @id @default(uuid())
  phone     String
  purpose   String   // REGISTER | RESET_PASSWORD
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([phone, purpose])
}

model PendingRegistration {
  phone     String   @id
  payload   String   // JSON user fields pending OTP
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Report {
  id              String   @id @default(uuid())
  reporterId      String
  reporter        User     @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId  String
  reportedUser    User     @relation("Reported", fields: [reportedUserId], references: [id])
  bookingId       String?
  reason          String   // HARASSMENT | NO_SHOW | SCAM | INAPPROPRIATE | OTHER
  description     String
  screenshotUrl   String?
  disputeText     String?
  disputeProofUrl String?
  disputedAt      DateTime?
  status          String   @default("PENDING") // PENDING | DISPUTED | RESOLVED | ACTIONED
  createdAt       DateTime @default(now())
}

// ===== Platform Payment =====
model Payment {
  id              String   @id @default(uuid())
  idempotencyKey  String   @unique
  type            String   // SUBSCRIPTION | BOOKING
  amount          Float
  platformFee     Float    @default(0)
  method          String?  // GCASH | MAYA | CARD
  status          String   @default("COMPLETED") // COMPLETED | FAILED
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  bookingId       String?  // only for BOOKING type
  subscriptionId  String?  // only for SUBSCRIPTION type
  booking         Booking?
  createdAt       DateTime @default(now())

  @@index([userId])
}

// ===== Lawyer Payout Request =====
model PayoutRequest {
  id              String   @id @default(uuid())
  lawyerId        String
  lawyer          User     @relation(fields: [lawyerId], references: [id])
  amount          Float
  method          String   // GCASH | BANK
  accountDetails  String   // JSON: {accountName, accountNumber, bankName?, provider?}
  status          String   @default("PENDING") // PENDING | PAID | REJECTED
  createdAt       DateTime @default(now())

  @@index([lawyerId])
}

model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
