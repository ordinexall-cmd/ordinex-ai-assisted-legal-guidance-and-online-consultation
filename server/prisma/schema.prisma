// ============================================================
// Ordinex — Prisma Schema
// Full 10-model schema matching the implementation plan.
// PostgreSQL (local Docker / Neon). CI and production use the same provider.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======================== MODELS ========================

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  phone             String         @unique
  passwordHash      String
  googleId          String?        @unique
  role              String         @default("CITIZEN") // CITIZEN | LAWYER
  name              String
  language          String         @default("en")
  isPremium         Boolean        @default(false)
  trialsUsed        Int            @default(0) // max 3 lifetime for free
  isFirstLogin      Boolean        @default(true) // for walkthrough
  isBanned          Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Structured Legal Name
  firstName         String?
  middleName        String?
  lastName          String?
  suffix            String?
  aliases           String? // A.K.A. / Maiden Name

  // Lawyer-specific fields
  barNumber         String?
  barAdmissionYear  Int?
  ibpChapter        String?
  ibpIdNumber       String?
  mcleComplianceNo  String?
  ptrNumber         String?
  ptrLgu            String?
  lawFirmName       String?
  specializations   String? // JSON array string: ["Criminal","Family"]
  consultationFee   Float? // legacy; synced from consultationFeeMin
  consultationFeeMin Float?
  consultationFeeMax Float?
  acceptingBookings Boolean        @default(true)
  bio               String?
  yearsOfExperience Int?
  practiceType      String? // "PUBLIC" | "PRIVATE"
  isVerified        Boolean        @default(false)
  avatarUrl         String?
  paymentMethods    String? // JSON: [{type, qrUrl, accountName}]
  // JSON array of {id, title, description, fileUrl, uploadedAt}
  // Used for ID proof, bar certificate, diplomas, etc.
  credentials       String?
  rating            Float          @default(0)
  ratingCount       Int            @default(0)
  noShowStrikes     Int            @default(0)

  // Lawyer wallet (platform-owned payment model)
  walletBalance     Float          @default(0) // withdrawable after COMPLETED
  walletPending     Float          @default(0) // held until consultation COMPLETED

  // Citizen personal-profile & legal capacity fields
  dob               String?
  gender            String?
  citizenship       String?        @default("Filipino")
  civilStatus       String?
  occupation        String?
  indigencyTier     String?        @default("STANDARD") // INDIGENT_PAO | LOW_INCOME | STANDARD | HIGH_NET_WORTH

  // Structured Philippine Address (PSGC)
  region            String?
  province          String?
  city              String?
  barangay          String?
  streetAddress     String?
  zipCode           String?
  address           String? // Full formatted address string

  // Citizen Identification & Emergency Contact
  citizenIdType         String? // PHILID | PASSPORT | DRIVERS_LICENSE | UMID | POSTAL | PRC | VOTER | STUDENT_ID | OTHER_GOV
  citizenIdNumber       String?
  citizenIdUrl          String?
  citizenIdBackUrl      String?
  citizenSelfieUrl      String?
  citizenVerificationStatus String @default("NOT_STARTED") // NOT_STARTED | PENDING | VERIFIED | REJECTED
  emailVerified         Boolean        @default(false)
  suspensionUntil       DateTime?
  suspensionReason      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelationship String?

  // Legal Compliance & Audit Trail (RA 10173)
  registrationIp    String?
  privacyConsentAt  DateTime?      @default(now())
  privacyConsentVer String?        @default("1.0")

  // Security question & hashed answer for 2-factor password reset
  securityQuestion    String?
  securityAnswerHash  String?

  // Lawyer KYC / identity-verification status machine.
  // NOT_STARTED → PENDING_UPLOAD → PROCESSING → (VERIFIED | NEEDS_REUPLOAD | REJECTED)
  lawyerVerificationStatus        String   @default("NOT_STARTED")
  lawyerVerificationScore         Float?   // 0-100 aggregate confidence
  lawyerVerificationRejectionReason String?
  lawyerVerificationCooldownUntil DateTime? // re-registration blocked until this date
  lawyerVerificationUpdatedAt     DateTime?

  // Relations
  consultations       Consultation[]
  availabilities      Availability[]
  bookingsAsCitizen   Booking[]      @relation("CitizenBookings")
  bookingsAsLawyer    Booking[]      @relation("LawyerBookings")
  reviews             Review[]
  subscription        Subscription?
  notifications       Notification[]
  reportsFiled        Report[]       @relation("Reporter")
  reportsReceived     Report[]       @relation("Reported")
  lawyerVerification  LawyerVerification?
  payments            Payment[]
  payoutRequests      PayoutRequest[]
  caseBriefs          CaseBrief[]
  briefInquiries      BriefInquiry[]
  briefViews          BriefView[]
}

// ===== Lawyer Identity Verification (no-admin pipeline) =====
// Stores artifacts (ID, selfie, payment-name) and per-attempt scoring
// for the deterministic AI-assisted verification flow described in the
// Ordinex Lawyer Verification blueprint.
model LawyerVerification {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Professional registry match
  submittedFullName      String?  // name lawyer entered
  submittedRollNumber    String?  // SC roll / IBP number
  rollMatchedName        String?  // canonical name from seed registry
  rollMatchHit           Boolean  @default(false)

  // Government-issued ID upload
  govIdType              String?  // e.g. PRC, Driver, Passport, NBI
  govIdUrl               String?
  govIdOcrName           String?  // extracted name from ID
  govIdOcrProvider       String?  // engine that read the ID: groq-vision | gemini-vision | tesseract.js | noop
  govIdUploadedAt        DateTime?

  // Selfie + dynamic challenge note
  challengeCode          String?  // e.g. ORD-2026-0526-AB12
  challengeIssuedAt      DateTime?
  selfieUrl              String?
  selfieUploadedAt       DateTime?

  // Scoring artefacts (each 0..1 unless noted)
  faceMatchScore         Float?   // 1 - normalized euclidean distance
  faceMatchProvider      String?  // engine that compared faces: groq-vision | gemini-vision | face-api.js | hash-stub | noop
  ocrNameMatchScore      Float?   // 0..1 similarity of OCR name vs roll name
  paymentAccountName     String?
  paymentNameMatchScore  Float?   // 0..1
  challengeCodeMatched   Boolean  @default(false)

  // Aggregate decision
  aggregateConfidence    Float    @default(0) // 0..100
  decision               String   @default("PENDING") // PENDING | AUTO_APPROVE | NEEDS_REUPLOAD | AUTO_REJECT
  decisionReason         String?
  decisionAt             DateTime?

  attempts               Int      @default(0)
  lastSubmittedAt        DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Cached snapshot of the public Supreme Court Lawyers List used for
// lawyer verification. Seed rows are for demo/dev only.
model RollOfAttorneys {
  rollNumber         String    @id
  fullName           String
  admittedAt         DateTime?
  status             String    @default("ACTIVE") // ACTIVE | SUSPENDED | DISBARRED
  region             String?
  address            String?
  lastLiveCheckedAt  DateTime?
  createdAt          DateTime  @default(now())

  @@index([fullName])
}

model Consultation {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  title           String?  // User-editable name for the analysis
  category        String
  description     String
  fileUrl         String? // Uploaded PDF/DOCX in Supabase Storage
  extractedText   String? // Parsed text from document
  aiResult        String // Full structured JSON from AI analysis (Groq)
  analysisMeta    String? // JSON: corpusSource, corpusFreshness, supersededWarning, providersUsed
  followUpHistory String? // JSON array of {role, content}
  followUpCount   Int      @default(0) // unlimited follow-ups; count kept for analytics
  isFree          Boolean  @default(true)
  trialsCharged   Boolean  @default(true) // false when needs_detail / no_corpus
  deletedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([userId, deletedAt])
}

model LawReference {
  id           String  @id @default(uuid())
  category     String
  name         String
  fullText     String
  link         String?
  keywords     String
  priority     String  @default("medium")
  guidanceJson String?
}

model Availability {
  id        String   @id @default(uuid())
  lawyerId  String
  lawyer    User     @relation(fields: [lawyerId], references: [id])
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  version   Int      @default(0) // optimistic locking
  createdAt DateTime @default(now())
  bookings  Booking[]
}

model Booking {
  id                String   @id @default(uuid())
  citizenId         String
  citizen           User     @relation("CitizenBookings", fields: [citizenId], references: [id])
  lawyerId          String
  lawyer            User     @relation("LawyerBookings", fields: [lawyerId], references: [id])
  availabilityId    String
  availability      Availability @relation(fields: [availabilityId], references: [id])
  preferredStartTime String?
  sessionStartTime  String?
  sessionEndTime    String?
  // REQUESTED | APPROVED | PAYMENT_SUBMITTED | CONFIRMED | DECLINED | AUTO_CANCELLED | NO_SHOW | IN_PROGRESS | COMPLETED | RATED
  status            String   @default("REQUESTED")
  feeAtBooking      Float // Price locked at booking time
  consultationId    String? // Optional linked AI analysis
  caseDescription   String? // Custom description from citizen
  paymentReference  String? // GCash/Maya reference number (legacy)
  paymentReceiptUrl String? // citizen-uploaded proof screenshot (legacy)
  paymentSnapshot   String? // JSON: payment method chosen at approve (legacy)
  paymentVerifiedAt DateTime?
  // Platform-owned payment fields
  quotedFee         Float?  // Set by lawyer on approve
  platformFee       Float?  // 10% commission, set on approve / payment
  lawyerShare       Float?  // 85% to lawyer, set on payment confirm
  paymentId         String? @unique // Links to Payment model
  approvedAt        DateTime? // For 24h unpaid expiry cron
  roomId            String? // Opaque PeerJS room token (UUID)
  transcript        String? // Call transcript
  recordingUrl      String? // Uploaded consultation recording (internal path)
  consultConsentAt  DateTime? // Server-audited preflight consent timestamp
  reminder15MinSent Boolean  @default(false)
  chatMessages      String? // JSON array of messages
  chatClosedAt      DateTime?
  noShowParty       String? // "CITIZEN" | "LAWYER"
  citizenDeletedAt  DateTime?
  lawyerDeletedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  review            Review?
  recordHash        RecordHash?
  payment           Payment? @relation(fields: [paymentId], references: [id])

  @@index([citizenId, citizenDeletedAt])
  @@index([lawyerId, lawyerDeletedAt])
  @@index([lawyerId, status])
  @@index([availabilityId])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  citizenId String
  citizen   User     @relation(fields: [citizenId], references: [id])
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  price     Float    @default(299)
  status    String   @default("ACTIVE") // ACTIVE | EXPIRED
  reference String? // Payment reference number
  startDate DateTime @default(now())
  endDate   DateTime // startDate + 30 days
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String // AI_READY, BOOKING_REQUEST, BOOKING_APPROVED, etc.
  isRead    Boolean  @default(false)
  linkTo    String? // URL to navigate to
  createdAt DateTime @default(now())
}

model RecordHash {
  id               String    @id @default(uuid())
  bookingId        String    @unique
  booking          Booking   @relation(fields: [bookingId], references: [id])
  dataHash         String // SHA-256
  previousHash     String? // Chain linkage
  blockchainTxHash String? // Ethereum tx hash
  anchoredAt       DateTime?
  createdAt        DateTime  @default(now())
}

model OtpChallenge {
  id        String   @id @default(uuid())
  phone     String
  purpose   String // REGISTER | RESET_PASSWORD
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([phone, purpose])
}

model PendingRegistration {
  phone     String   @id
  payload   String // JSON user fields pending OTP
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Report {
  id              String   @id @default(uuid())
  reporterId      String
  reporter        User     @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId  String
  reportedUser    User     @relation("Reported", fields: [reportedUserId], references: [id])
  bookingId       String?
  reason          String // HARASSMENT | NO_SHOW | SCAM | INAPPROPRIATE | OTHER
  description     String
  screenshotUrl   String?
  disputeText     String?
  disputeProofUrl String?
  disputedAt      DateTime?
  status          String   @default("PENDING") // PENDING | DISPUTED | RESOLVED | ACTIONED
  createdAt       DateTime @default(now())
}

// ===== Platform Payment (simulated checkout v1, PayMongo v2) =====
model Payment {
  id              String   @id @default(uuid())
  idempotencyKey  String   @unique
  type            String   // SUBSCRIPTION | BOOKING
  amount          Float
  platformFee     Float    @default(0)
  method          String?  // GCASH | MAYA | CARD (mock for v1)
  status          String   @default("COMPLETED") // COMPLETED | FAILED
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  bookingId       String?  // only for BOOKING type
  subscriptionId  String?  // only for SUBSCRIPTION type
  booking         Booking?
  createdAt       DateTime @default(now())

  @@index([userId])
}

// ===== Lawyer Payout Request =====
model PayoutRequest {
  id              String   @id @default(uuid())
  lawyerId        String
  lawyer          User     @relation(fields: [lawyerId], references: [id])
  amount          Float
  method          String   // GCASH | BANK
  accountDetails  String   // JSON: {accountName, accountNumber, bankName?, provider?}
  status          String   @default("PENDING") // PENDING | PAID | REJECTED
  createdAt       DateTime @default(now())

  @@index([lawyerId])
}

/** Key-value store for app flags (e.g. demo_seed_version). */
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CaseBrief {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String
  summary         String
  consultationId  String?  // Optional linked AI case analysis
  budgetMin       Float?
  budgetMax       Float?
  city            String?
  province        String?
  displayName     String
  anonymous       Boolean  @default(false)
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  inquiries       BriefInquiry[]
  views           BriefView[]

  @@index([status, category])
  @@index([userId])
}

model BriefView {
  id        String    @id @default(uuid())
  briefId   String
  brief     CaseBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  lawyerId  String
  lawyer    User      @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  viewedAt  DateTime  @default(now())

  @@unique([briefId, lawyerId])
  @@index([lawyerId])
  @@index([briefId])
}

model BriefInquiry {
  id        String    @id @default(uuid())
  briefId   String
  brief     CaseBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  lawyerId  String
  lawyer    User      @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  message   String?
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([briefId, lawyerId])
  @@index([lawyerId])
}
