# ============================================================
# Ordinex Backend — Environment template
# Copy to server/.env and fill in real values. NEVER commit .env.
# ============================================================

# --- Runtime ---
PORT=5000
NODE_ENV=development
# Public HTTPS origin of the deployed app (Render URL in production).
API_PUBLIC_URL=http://localhost:5000
# Number of proxy hops in front of the app (Render = 1). Leave blank locally.
TRUST_PROXY=

# --- Database (Supabase PostgreSQL) ---
# Connect → ORMs → Prisma: transaction pooler → DATABASE_URL, session/direct → DIRECT_URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (production uploads on Render — optional locally) ---
# Project Settings → API → Project URL + service_role key (keep secret).
# Create public buckets: documents, avatars, verification, payments, credentials, reports, recordings, consultations
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Auth ---
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production requires >= 32 chars and rejects the known dev value.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Email (Gmail / SMTP) ---
EMAIL_FROM="Ordinex <you@example.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""

# --- AI: Groq (case analysis / chat / KYC vision) ---
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_LIGHT_MODEL="openai/gpt-oss-20b"
GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# --- AI: Google Gemini (live consult transcript + vision fallback) ---
# Required for Start listening captions during video sessions.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Frontend origin (production: same Render HTTPS URL as API_PUBLIC_URL) ---
FRONTEND_URL="http://localhost:5173"

# --- Trust & bookings ---
NO_SHOW_STRIKE_LIMIT=3
REQUESTED_BOOKING_EXPIRE_HOURS=72
APPROVED_BOOKING_EXPIRE_HOURS=24

# --- Payments (simulated | paymongo) ---
# Free demo deploys should use "simulated". "paymongo" requires the keys below
# plus PAYMONGO_WEBHOOK_SECRET (enforced in production).
PAYMENTS_MODE=simulated
PLATFORM_MERCHANT_NAME="Ordinex Legal Tech"
PLATFORM_COMMISSION_RATE=0.15
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# --- Admin ---
ADMIN_EMAILS=""

# --- Dev-only lawyer KYC panel bypass (requires NODE_ENV=development) ---
# ENABLE_PANEL_DEMO=true
