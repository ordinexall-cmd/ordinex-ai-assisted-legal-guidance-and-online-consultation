{
  "name": "oxfinal",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:all": "npx -y concurrently -n web,api -c blue,green \"npm run dev\" \"npm run server:dev\"",
    "dev:help": "node -e \"console.log('Start stack: npm run dev:all\\nLAN phone: use Network URL from Vite (e.g. http://192.168.1.5:5173)\\nProduction PWA: open your Render URL in Safari → Share → Add to Home Screen\\nAPI only: npm run server:dev\\nFrontend only: npm run dev')\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host",
    "start": "node server/src/index.js",
    "render:build": "NPM_CONFIG_PRODUCTION=false npm install && npm run build && cd server && npm install && npx prisma generate",
    "render:start": "cd server && node src/index.js",
    "server:dev": "npm run dev --prefix server",
    "server:seed": "npm run db:seed --prefix server",
    "server:sync-demo": "npm run db:sync-demo --prefix server",
    "server:reset-demo": "npm run db:reset-demo --prefix server",
    "server:defense-reset": "npm run db:defense-reset --prefix server",
    "server:verify": "npm run verify:env --prefix server",
    "server:test:smoke": "npm run test:smoke --prefix server",
    "server:test:api": "npm run test:api --prefix server",
    "server:test:demo": "npm run test:demo --prefix server",
    "server:test:defense-flow": "npm run test:defense-flow --prefix server",
    "server:test:socket": "npm run test:socket --prefix server",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
